{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "replicaCount": {
      "enum": [
        0,
        1
      ]
    },
    "radio": {
      "type": "object",
      "properties": {
        "gnbId": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4194303
        },
        "cellId": {
          "type": "integer",
          "minimum": 0,
          "maximum": 68719476735
        },
        "duId": {
          "type": "integer",
          "minimum": 0,
          "maximum": 68719476735
        },
        "pci": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1007
        },
        "ssbPower": {
          "type": "integer",
          "minimum": -60,
          "maximum": 50
        }
      },
      "required": [
        "gnbId",
        "cellId",
        "duId",
        "pci",
        "ssbPower"
      ],
      "additionalProperties": false
    },
    "nodeSelector": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "affinity": {
      "type": "object"
    },
    "tolerations": {
      "type": "array"
    },
    "experimentalTransport": {
      "type": "boolean"
    }
  }
}
