# Declarative KEY=literal configuration; this file is NOT shell code.
# Copy to config/global.env, chmod 600, then set required credentials.
# Precedence: built-in canonical defaults < global.env < named environment variables.
# Quotes are optional; no substitutions run. Only path fields expand $HOME or ~/.
# Empty host values use the selected default route, never the first interface.
HOST_IP=
HOST_INTERFACE=
REPO_ROOT=
# Default: <checkout>/.runtime (ignored). External absolute directories allowed.
RUNTIME_DIR=
KUBECONFIG_PATH=
# Empty uses KUBECONFIG_PATH; default is this user's ~/.kube/config.
OSM_KUBECONFIG_PATH=
DEPLOYMENT_PROFILE=rfsim
POD_CIDR=10.244.0.0/16
SERVICE_CIDR=10.96.0.0/12
UE_CIDR=10.45.0.0/16
EDGE_CIDR=10.47.0.0/16
KUBELET_MAX_PODS=200
# Empty HOST derives https://gui.<HOST_IP>.nip.io:<OSM_HTTPS_PORT> for this project's topology.
# Override for another installation; HTTPS certificate verification is mandatory.
OSM_HOST=
OSM_BASE_DOMAIN=
OSM_HTTPS_PORT=30843
OSM_NAMESPACE=osm
OSM_USER=admin
OSM_PASSWORD=admin
# Expected project name is required; optional explicit ID disambiguates that name.
OSM_PROJECT=admin
OSM_PROJECT_ID=
# Configure expected name OR explicit UUID; no arbitrary VIM selection.
OSM_VIM_NAME=dummyvim
OSM_VIM_ACCOUNT_ID=
OSM_K8S_CLUSTER_ID=
# Empty discovers only an existing namespace named exactly as the resolved project UUID.
# Other OSM namespace conventions require this explicit override.
OSM_PROJECT_NAMESPACE=
PROMETHEUS_NODEPORT=30990
GRAFANA_NODEPORT=31998
DASHBOARD_PORT=8090
RANCHER_PORT=8443
# Empty URLs derive from host/ports; localhost is used for local service clients.
PROMETHEUS_URL=
GRAFANA_URL=
DASHBOARD_URL=
RANCHER_URL=
# Lab/demo defaults for the submission build. Change these for non-lab use.
GRAFANA_ADMIN_PASSWORD=admin
RANCHER_BOOTSTRAP_PASSWORD=admin
# Canonical reference-profile semantics; not inferred from host networking.
MCC=208
MNC=93
TAC=1
SST=1
SD=010203
DNN=internet
LAYER3_BLER_THRESHOLD=0.05
LAYER3_CHECK_INTERVAL_SECONDS=10
LAYER3_COOLDOWN_SECONDS=120
# Required to start the watcher: explicitly select a ready registry scenario.
LAYER3_FAILOVER_SCENARIO=cran-srsran
ACTIONS_LOG_PATH=
# External hardware/blocked-component dependencies: explicitly supplied, never home defaults.
RF_DEVICE_ARGS=
SRSRAN_BINARY=
IMS_CONFIG_PATH=
IMS_MYSQL_DATA_PATH=
FLEXRIC_ADDRESS=
OSM_CA_CERT_PATH=
# Only needed when initially changing the upstream OSM administrator password.
OSM_BOOTSTRAP_PASSWORD=admin
OSM_CLUSTER_NAME=submission-cluster
# Authorized mongodump --archive --gzip file, owner-only; never commit it.
SUBSCRIBER_DATABASE_INPUT=

# Benchmark server must already exist; this phase does not create it.
BENCH_IPERF_HOST=
BENCH_IPERF_PORT=5201
BENCH_PING_HOST=8.8.8.8

INGRESS_HTTP_NODEPORT=32080
