# ==============================================================================
# 5G Kubernetes Orchestrator — Global Configuration
# ==============================================================================
# Copy this file to config/global.env and edit the values genuinely specific
# to your machine. Everything else has a sane default for a fresh, compatible
# single-node install.
#
#   cp config/global.env.example config/global.env
#
# scripts/common.sh loads config/global.env if it exists, and falls back to
# the defaults below (auto-detecting where documented) if it doesn't.
# ==============================================================================

# ------------------------------------------------------------------------
# HOST NETWORKING
# ------------------------------------------------------------------------
# The IP address this machine is reachable on. Used to build OSM's,
# Grafana's, and the dashboard's URLs. If left empty, scripts/common.sh
# auto-detects it via `hostname -I | awk '{print $1}'`.
HOST_IP=

# The network interface HOST_IP lives on (used by Multus for RAN charts
# that need a second interface). Auto-detected via
# `ip route get 1.1.1.1 | awk '{print $5; exit}'` if left empty.
HOST_INTERFACE=

# ------------------------------------------------------------------------
# KUBERNETES
# ------------------------------------------------------------------------
# Path to the admin kubeconfig kubeadm produces. install.sh copies this
# from /etc/kubernetes/admin.conf on first run if the file doesn't exist.
KUBECONFIG_PATH="$HOME/.kube/config"

# Separate kubeconfig OSM's own tooling and the dashboard use — on this
# project's reference machine this has historically been a distinct copy
# at ~/osm-kubeconfig.yaml. Set the same as KUBECONFIG_PATH unless you
# have a reason to keep them separate.
OSM_KUBECONFIG_PATH="$HOME/osm-kubeconfig.yaml"

# Raise this if the default (110) is too low for the pod count this
# platform needs on a single node (core + RAN + monitoring + UE can
# exceed 60-70 pods before you add a second RAN scenario).
KUBELET_MAX_PODS=200

# ------------------------------------------------------------------------
# OSM (Open Source MANO)
# ------------------------------------------------------------------------
# OSM's GUI/NBI is served behind nip.io using HOST_IP, so it needs no DNS.
# Leave empty to derive automatically as "${HOST_IP}.nip.io".
OSM_BASE_DOMAIN=

# Port the ingress exposes OSM's HTTPS GUI/NBI on.
OSM_HTTPS_PORT=30843

OSM_USER=admin
OSM_PASSWORD=admin
OSM_PROJECT=admin

# OSM generates these UUIDs itself on first onboarding of the VIM account
# and K8s cluster — do NOT hardcode a value copied from another machine.
# scripts/osm/discover-ids.sh writes them here after a fresh OSM install.
OSM_VIM_ACCOUNT_ID=
OSM_K8S_CLUSTER_ID=
OSM_PROJECT_NAMESPACE=

# ------------------------------------------------------------------------
# 5G CORE / RAN — PLMN AND SLICE
# ------------------------------------------------------------------------
MCC=208
MNC=93
TAC=1
SST=1
SD=010203
DNN=internet

# ------------------------------------------------------------------------
# MONITORING (Layer 2)
# ------------------------------------------------------------------------
GRAFANA_NODEPORT=31998
PROMETHEUS_NODEPORT=30990
GRAFANA_ADMIN_PASSWORD=admin

# ------------------------------------------------------------------------
# LAYER 3 — AUTONOMOUS WATCHER
# ------------------------------------------------------------------------
# Sustained BLER above this ratio (0.05 = 5%) is treated as SLA
# degradation and triggers an automatic RAN failover.
LAYER3_BLER_THRESHOLD=0.05
LAYER3_CHECK_INTERVAL_SECONDS=10
LAYER3_COOLDOWN_SECONDS=120
LAYER3_FAILOVER_SCENARIO=hcran-oai

# ------------------------------------------------------------------------
# DASHBOARD
# ------------------------------------------------------------------------
DASHBOARD_PORT=8090

# ------------------------------------------------------------------------
# REPOSITORY PATHS (usually fine as-is)
# ------------------------------------------------------------------------
REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
