diff --git a/lib/cu_cp/cu_cp_controller/ngap_application_snapshot.h b/lib/cu_cp/cu_cp_controller/ngap_application_snapshot.h
new file mode 100644
index 0000000000..1c32d062d8
--- /dev/null
+++ b/lib/cu_cp/cu_cp_controller/ngap_application_snapshot.h
@@ -0,0 +1,234 @@
+/* Default-off experimental read-only telemetry. Approved baseline: 11c9bbabb69873752500d676f55e0034f6caa5c5.
+ * No listener, timer, protocol operation, callback into a controller, or subscriber data.
+ */
+#pragma once
+#include "srsran/support/executors/task_executor.h"
+#include <array>
+#include <atomic>
+#include <chrono>
+#include <cstdint>
+#include <memory>
+#include <limits>
+#include <string_view>
+#include <sys/random.h>
+
+namespace srsran { namespace srs_cu_cp {
+namespace ngap_snapshot {
+constexpr unsigned max_peers = 64;
+struct text {
+  std::array<char, 97> bytes{};
+  bool set(std::string_view s) noexcept {
+    if (s.empty() || s.size() >= bytes.size()) { return false; }
+    for (char c : s) { if (c < 32 || c > 126) { return false; } }
+    bytes.fill(0);
+    for (unsigned i = 0; i != s.size(); ++i) { bytes[i] = s[i]; }
+    return true;
+  }
+  bool empty() const noexcept { return bytes[0] == 0; }
+  bool operator==(const text& rhs) const noexcept { return bytes == rhs.bytes; }
+};
+struct stamp { int64_t wall_ns = 0; int64_t monotonic_ns = 0; };
+inline stamp now() noexcept {
+  return {std::chrono::duration_cast<std::chrono::nanoseconds>(std::chrono::system_clock::now().time_since_epoch()).count(),
+          std::chrono::duration_cast<std::chrono::nanoseconds>(std::chrono::steady_clock::now().time_since_epoch()).count()};
+}
+enum class state { unknown, up, down }; // local application state, NEVER a HEALTHY service claim.
+enum class reason { no_evidence, setup_started, setup_success, setup_failed, authority_mismatch, peer_mismatch,
+                    association_lost, removal_started, removed, reconnect_started, reconnect_failed, contradictory_result };
+struct peer_binding { uint32_t amf_index = 0; text peer_id; text expected_amf_name; };
+struct config {
+  bool enabled = false; // No existing constructor call enables this source.
+  text local_nf_id;
+  unsigned peer_count = 0;
+  std::array<peer_binding, max_peers> peers{};
+};
+struct row {
+  peer_binding binding;
+  text observed_amf_name;
+  state application_state = state::unknown;
+  reason why = reason::no_evidence;
+  uint64_t association_generation = 0;
+  bool setup_pending = false; // Exactly one terminal setup result per generation.
+  bool transition_known = false;
+  stamp last_transition{}; // event observation, NOT actual remote fault onset.
+};
+struct snapshot {
+  bool valid = false;
+  bool complete = false;
+  text local_nf_id;
+  text process_incarnation;
+  const char* producer_revision = "11c9bbabb69873752500d676f55e0034f6caa5c5";
+  const char* instrumentation_revision = "ngap-snapshot-stage-a-v1-uncompiled";
+  uint64_t state_revision = 0;
+  uint64_t sequence = 0; // also the owner-produced heartbeat sequence.
+  stamp observed_at{};
+  unsigned peer_count = 0;
+  std::array<row, max_peers> peers{};
+};
+static_assert(sizeof(snapshot) <= 65536, "Snapshot must remain within its bounded response budget");
+struct owner_data {
+  snapshot value{}; // Mutable fields are accessed ONLY by the permanently bound CU executor.
+  std::atomic<uint64_t> revision{0};
+  std::atomic<bool> closed{false};
+  std::atomic<bool> busy{false};
+};
+static_assert(std::atomic<uint64_t>::is_always_lock_free && std::atomic<bool>::is_always_lock_free,
+              "Snapshot requires lock-free publication atomics");
+class ticket {
+public:
+  explicit ticket(std::shared_ptr<owner_data> d) : data(std::move(d)), requested_at(now()) {}
+  ~ticket() { data->busy.store(false, std::memory_order_release); }
+  snapshot inspect(const text& expected_incarnation) const noexcept {
+    snapshot out{};
+    if (!ready.load(std::memory_order_acquire)) { return out; }
+    out = value; // one immutable result, published once with release/acquire.
+    const auto t = now();
+    if (!out.valid || !out.complete || data->closed.load(std::memory_order_acquire) ||
+        data->revision.load(std::memory_order_acquire) != out.state_revision ||
+        !(out.process_incarnation == expected_incarnation) ||
+        t.monotonic_ns < out.observed_at.monotonic_ns ||
+        t.monotonic_ns - out.observed_at.monotonic_ns > 30000000000LL) {
+      out.valid = false; out.complete = false;
+      for (auto& p : out.peers) { p.application_state = state::unknown; }
+    }
+    return out;
+  }
+private:
+  friend class source;
+  std::shared_ptr<owner_data> data;
+  stamp requested_at;
+  snapshot value{};
+  std::atomic<bool> ready{false};
+};
+class source {
+public:
+  static std::unique_ptr<source> create(const config& c, task_executor& owner) {
+    if (!c.enabled || c.local_nf_id.empty() || c.peer_count == 0 || c.peer_count > max_peers) { return {}; }
+    for (unsigned i = 0; i != c.peer_count; ++i) {
+      if (c.peers[i].peer_id.empty() || c.peers[i].expected_amf_name.empty()) { return {}; }
+      for (unsigned j = 0; j != i; ++j) {
+        if (c.peers[i].amf_index == c.peers[j].amf_index || c.peers[i].peer_id == c.peers[j].peer_id) { return {}; }
+      }
+    }
+    std::array<unsigned char, 16> nonce{};
+    // Initialization only. No blocking entropy wait, retry or timestamp/PID fallback.
+    if (::getrandom(nonce.data(), nonce.size(), GRND_NONBLOCK) != static_cast<ssize_t>(nonce.size())) { return {}; }
+    text incarnation;
+    constexpr char hex[] = "0123456789abcdef";
+    for (unsigned i = 0; i != nonce.size(); ++i) {
+      incarnation.bytes[2*i] = hex[nonce[i] >> 4]; incarnation.bytes[2*i+1] = hex[nonce[i] & 15];
+    }
+    return std::unique_ptr<source>(new source(c, incarnation, owner));
+  }
+  ~source() { close(); }
+  void close() noexcept { data->closed.store(true, std::memory_order_release); }
+  source(const source&) = delete;
+  source& operator=(const source&) = delete;
+
+  // Lifecycle hooks below MUST run on the same serialized CU executor as the original state writes.
+  uint64_t begin(uint32_t index, bool reconnect = false) noexcept {
+    auto* p = find(index); if (!p || !advance(*p)) { return 0; }
+    p->observed_amf_name = {}; p->setup_pending = true;
+    update(*p, state::unknown, reconnect ? reason::reconnect_started : reason::setup_started);
+    return p->association_generation;
+  }
+  void setup_result(uint32_t index, bool success, std::string_view actual_name, bool authority_verified, uint64_t generation = 0) noexcept {
+    auto* p = find(index); if (!p || generation == 0 || generation != p->association_generation) { return; }
+    if (!p->setup_pending) {
+      text observed;
+      const bool duplicate = authority_verified &&
+          ((success && p->application_state == state::up && observed.set(actual_name) &&
+            observed == p->observed_amf_name) ||
+           (!success && p->application_state == state::down && p->why == reason::setup_failed));
+      // Exact duplicate terminals are idempotent. Contradictory terminals cannot retain UP/DOWN.
+      if (!duplicate && p->application_state != state::unknown && advance(*p)) {
+        update(*p, state::unknown, reason::contradictory_result);
+      }
+      return;
+    }
+    p->setup_pending = false;
+    if (!authority_verified) { update(*p, state::unknown, reason::authority_mismatch); return; }
+    if (!success) { update(*p, state::down, reason::setup_failed); return; }
+    text observed;
+    if (!observed.set(actual_name) || !(observed == p->binding.expected_amf_name)) {
+      update(*p, state::unknown, reason::peer_mismatch); return;
+    }
+    p->observed_amf_name = observed;
+    update(*p, state::up, reason::setup_success);
+  }
+  void unavailable(uint32_t index) noexcept {
+    auto* p = find(index); if (p && advance(*p)) { update(*p, state::unknown, reason::no_evidence); }
+  }
+  void lost(uint32_t index) noexcept {
+    auto* p = find(index); if (p && advance(*p)) { update(*p, state::down, reason::association_lost); }
+  }
+  uint64_t removing(uint32_t index) noexcept {
+    auto* p = find(index); if (!p || !advance(*p)) { return 0; }
+    update(*p, state::unknown, reason::removal_started);
+    return p->association_generation;
+  }
+  void removed(uint32_t index, bool authority_verified, uint64_t generation) noexcept {
+    auto* p = find(index); if (p && generation != 0 && generation == p->association_generation) { update(*p, authority_verified ? state::down : state::unknown,
+                                       authority_verified ? reason::removed : reason::authority_mismatch); }
+  }
+  text incarnation() const noexcept { return data->value.process_incarnation; } // immutable since construction
+  // Caller must keep manager/executor alive until this call returns. Deferred task captures NO manager/raw source.
+  // Ticket bounds outstanding work/storage to one result until its last reference is released.
+  std::shared_ptr<ticket> request() {
+    if (data->closed.load(std::memory_order_acquire) || data->busy.exchange(true, std::memory_order_acq_rel)) { return {}; }
+    std::shared_ptr<ticket> result;
+    try { result = std::make_shared<ticket>(data); }
+    catch (...) { data->busy.store(false, std::memory_order_release); throw; }
+    auto d = data;
+    if (!owner.defer([d, result]() {
+      const auto t = now();
+      if (!d->closed.load(std::memory_order_acquire) &&
+          t.monotonic_ns >= result->requested_at.monotonic_ns &&
+          t.monotonic_ns - result->requested_at.monotonic_ns <= 10000000LL) {
+        d->value.observed_at = t;
+        if (d->value.sequence == std::numeric_limits<uint64_t>::max()) { d->value.complete = false; }
+        else { ++d->value.sequence; }
+        d->value.state_revision = d->revision.load(std::memory_order_relaxed);
+        result->value = d->value;
+        result->value.valid = d->value.complete;
+      }
+      result->ready.store(true, std::memory_order_release);
+    })) { return {}; } // No retry; destruction releases admission.
+    return result;
+  }
+private:
+  source(const config& c, const text& incarnation, task_executor& owner_) :
+    owner(owner_), data(std::make_shared<owner_data>()) {
+    data->value.local_nf_id = c.local_nf_id; data->value.process_incarnation = incarnation;
+    data->value.complete = true; data->value.peer_count = c.peer_count;
+    for (unsigned i = 0; i != c.peer_count; ++i) { data->value.peers[i].binding = c.peers[i]; }
+  }
+  row* find(uint32_t index) noexcept {
+    if (data->closed.load(std::memory_order_acquire)) { return nullptr; }
+    for (unsigned i = 0; i != data->value.peer_count; ++i) {
+      if (data->value.peers[i].binding.amf_index == index) { return &data->value.peers[i]; }
+    }
+    data->value.complete = false; bump_revision(); // Unknown/unconfigured peer => fail closed; no dynamic insertion/eviction.
+    return nullptr;
+  }
+  void bump_revision() noexcept {
+    if (data->revision.fetch_add(1, std::memory_order_release) == std::numeric_limits<uint64_t>::max()) {
+      data->closed.store(true, std::memory_order_release);
+    }
+  }
+  bool advance(row& p) noexcept {
+    if (p.association_generation == std::numeric_limits<uint64_t>::max()) {
+      data->value.complete = false; bump_revision(); return false;
+    }
+    ++p.association_generation; p.setup_pending = false; return true;
+  }
+  void update(row& p, state s, reason why) noexcept {
+    if (p.application_state != s) { p.last_transition = now(); p.transition_known = true; }
+    p.application_state = s; p.why = why;
+    bump_revision();
+  }
+  task_executor& owner; // Verified CU executor, fixed at construction; requesters cannot substitute it.
+  std::shared_ptr<owner_data> data;
+};
+} // namespace ngap_snapshot
+} } // namespace srsran::srs_cu_cp
