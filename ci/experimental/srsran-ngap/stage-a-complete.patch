+"""SYNTHETIC executable contract model, NOT execution/compilation of C++ instrumentation."""
+import copy
+class Owner:
+    def __init__(self):self.queue=[];self.active=False;self.accept=True
+    def defer(self,f):
+        if not self.accept:return False
+        self.queue.append(f);return True
+    def run(self,f=None):
+        self.active=True
+        try:
+            if f is not None:return f()
+            while self.queue:self.queue.pop(0)()
+        finally:self.active=False
+class Source:
+    def __init__(self,owner,clock,*,enabled=False,peers=None,incarnation='SYNTHETIC_PROCESS_A'):
+        self.owner=owner;self.clock=clock;self.enabled=enabled and bool(peers) and len(peers)<=64;self.incarnation=incarnation
+        self.peers={i:{'expected':n,'state':'UNKNOWN','generation':0,'transition':None,'observed_name':None,'pending':False,'why':'no_evidence'} for i,n in (peers or {}).items()}
+        self.complete=bool(peers) and len(self.peers)<=64;self.closed=False;self.busy=False;self.revision=0;self.sequence=0;self.active_ticket=None
+    def find(self,i):
+        assert self.owner.active,'owner executor required'
+        if self.closed:return None
+        if i not in self.peers:self.complete=False;self.revision+=1;return None
+        return self.peers[i]
+    def update(self,p,state,why=None):
+        if p['state']!=state:p['transition']=self.clock[0]
+        p['state']=state;p['why']=why;self.revision+=1
+    def begin(self,i):
+        p=self.find(i)
+        if p is None:return 0
+        p['generation']+=1;p['observed_name']=None;p['pending']=True;self.update(p,'UNKNOWN','begin');return p['generation']
+    def setup(self,i,g,success=True,name='SYNTHETIC_AMF_A',authority=True):
+        p=self.find(i)
+        if p is None or not g or g!=p['generation']:return
+        if not p['pending']:
+            duplicate=authority and ((success and p['state']=='UP' and name==p['observed_name']) or (not success and p['state']=='DOWN' and p['why']=='setup_failed'))
+            if not duplicate and p['state']!='UNKNOWN':
+                p['generation']+=1;self.update(p,'UNKNOWN','contradictory_result')
+            return
+        p['pending']=False
+        state='UNKNOWN' if not authority else 'DOWN' if not success else 'UP' if name==p['expected'] else 'UNKNOWN'
+        if state=='UP':p['observed_name']=name
+        self.update(p,state,'setup_success' if state=='UP' else 'setup_failed' if state=='DOWN' else 'unverified')
+    def lost(self,i):
+        p=self.find(i)
+        if p is not None:p['generation']+=1;p['pending']=False;self.update(p,'DOWN','lost')
+    def unavailable(self,i):
+        p=self.find(i)
+        if p is not None:p['generation']+=1;p['pending']=False;self.update(p,'UNKNOWN','no_evidence')
+    def removing(self,i):
+        p=self.find(i)
+        if p is None:return 0
+        p['generation']+=1;p['pending']=False;self.update(p,'UNKNOWN','removing');return p['generation']
+    def removed(self,i,g,authority=True):
+        p=self.find(i)
+        if p is not None and g and g==p['generation']:self.update(p,'DOWN' if authority else 'UNKNOWN','removed')
+    def close(self):self.closed=True
+    def request(self):
+        if not self.enabled or self.closed or self.busy:return None
+        self.busy=True;t={'requested':self.clock[0],'ready':False,'payload':None,'released':False};self.active_ticket=t
+        def publish():
+            if not self.closed and 0<=self.clock[0]-t['requested']<=0.010:
+                self.sequence+=1;t['payload']={'valid':self.complete,'at':self.clock[0],'incarnation':self.incarnation,'revision':self.revision,'sequence':self.sequence,'peers':copy.deepcopy(self.peers)}
+            t['ready']=True
+            if t['released']:self.busy=False;self.active_ticket=None
+        if not self.owner.defer(publish):self.busy=False;self.active_ticket=None;return None
+        return t
+    def inspect(self,t,expected='SYNTHETIC_PROCESS_A'):
+        if t is None or not t['ready'] or t['payload'] is None:return {'valid':False,'peers':{}}
+        p=copy.deepcopy(t['payload'])
+        if not p['valid'] or self.closed or p['incarnation']!=expected or p['revision']!=self.revision or not 0<=self.clock[0]-p['at']<=30:
+            p['valid']=False
+            for row in p['peers'].values():row['state']='UNKNOWN'
+        return p
+    def release(self):
+        if self.active_ticket is not None:
+            self.active_ticket['released']=True
+            if self.active_ticket['ready']:self.busy=False;self.active_ticket=None
