[Unit]
Description=Layer 3 Autonomous Optimization Watcher
After=network.target ran-selector.service

[Service]
Type=simple
User=PLACEHOLDER_USER
WorkingDirectory=PLACEHOLDER_REPO_ROOT/layer3-autonomous
Environment=PROMETHEUS_URL=PLACEHOLDER_PROMETHEUS_URL
Environment=DASHBOARD_URL=PLACEHOLDER_DASHBOARD_URL
Environment=CHECK_INTERVAL_SECONDS=PLACEHOLDER_CHECK_INTERVAL_SECONDS
Environment=ACTION_COOLDOWN_SECONDS=PLACEHOLDER_ACTION_COOLDOWN_SECONDS
Environment=BLER_THRESHOLD=PLACEHOLDER_BLER_THRESHOLD
Environment=FAILOVER_SCENARIO=PLACEHOLDER_FAILOVER_SCENARIO
ExecStart=/usr/bin/python3 PLACEHOLDER_REPO_ROOT/layer3-autonomous/watcher.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
