[Unit]
Description=Layer 3 Autonomous Optimization Watcher
After=network.target ran-selector.service

[Service]
Type=simple
User=PLACEHOLDER_USER
WorkingDirectory=PLACEHOLDER_REPO_ROOT/layer3-autonomous
ExecStart=/usr/bin/python3 PLACEHOLDER_REPO_ROOT/layer3-autonomous/watcher.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
