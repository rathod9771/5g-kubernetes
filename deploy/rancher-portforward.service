[Unit]
Description=Persistent port-forward to Rancher (svc/rancher PLACEHOLDER_RANCHER_PORT:443)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=PLACEHOLDER_USER
Environment=KUBECONFIG=PLACEHOLDER_KUBECONFIG_PATH
ExecStart=/usr/bin/kubectl port-forward -n cattle-system svc/rancher PLACEHOLDER_RANCHER_PORT:443 --address 0.0.0.0
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
