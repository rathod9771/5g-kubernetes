[Unit]
Description=5G RAN Selector dashboard
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=PLACEHOLDER_USER
WorkingDirectory=PLACEHOLDER_REPO_ROOT/ran-selector
# Runtime configuration is read from config/global.env by the dashboard.
ExecStart=PLACEHOLDER_REPO_ROOT/ran-selector/venv/bin/python3 PLACEHOLDER_REPO_ROOT/ran-selector/backend.py
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
